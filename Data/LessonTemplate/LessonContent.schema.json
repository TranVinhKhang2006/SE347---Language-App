{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "LessonContentTemplate",
    "type": "object",
    "description": "Content items for a lesson. Each item is keyed by a sequential content identifier such as content.1.",
    "minProperties": 1,
    "properties": {
        "$schema": {
            "type": "string"
        }
    },
    "patternProperties": {
        "^content\\.[1-9][0-9]*$": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "content": {
                    "type": "string",
                    "description": "The word, phrase, or title being taught.",
                    "minLength": 1
                },
                "description": {
                    "type": "string",
                    "description": "An explanation of the word or phrase.",
                    "minLength": 1
                },
                "translation": {
                    "type": "string",
                    "description": "The Vietnamese translation of the content.",
                    "minLength": 1
                },
                "image": {
                    "type": "string",
                    "description": "The image filename associated with the content.",
                    "minLength": 1
                }
            },
            "required": [
                "content",
                "description",
                "translation",
                "image"
            ]
        }
    },
    "additionalProperties": false
}