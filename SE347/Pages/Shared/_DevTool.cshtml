<!-- Dev Tools Component -->
<style>
    /* ==========================================
    DEV TOOLS STYLES (Styled to match Login Theme)
    ========================================== */

    .dev-tools,
    .dev-tools *,
    .dev-tools *::before,
    .dev-tools *::after {
        box-sizing: border-box;
        font-family: "Segoe UI", sans-serif;
    }

    .dev-tools {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 52px; /* Kích thước khi thu gọn */
        z-index: 9999;
        
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        padding: 0.5rem 1rem;
        
        background: #ffffff;
        border-top: 1px solid #dbe5f5;
        box-shadow: 0 -4px 20px rgba(28, 57, 99, 0.08);
        transition: height 0.25s ease, transform 0.25s ease, opacity 0.25s ease;

        &.hidden {
            transform: translateY(100%);
            opacity: 0;
            pointer-events: none;
        }

        /* Khi bấm nút Expand để mở rộng console log */
        &.expanded {
            height: 180px;
        }

        /* Khung chứa các phần tử trên cùng */
        .dev-tools-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            gap: 10px;
        }

        /* Khối chứa Navigation */
        .dev-tools-nav {
            margin-top: 2px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 4px 8px;
            background: #f8fbff;
            border: 1px solid #b9c9e2;
            border-radius: 8px;
        }

        /* Các Nút Previous / Next */
        .dev-tools-nav-button {
            min-height: 32px;
            padding: 0 0.8rem;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.85rem;
            color: #ffffff;
            background: #2563eb;
            border: 0;
            border-radius: 6px;
            transition: background-color 0.2s ease, filter 0.2s ease;

            &:hover {
                filter: brightness(0.92);
            }

            &:focus {
                outline: 2px solid rgba(37, 99, 235, 0.25);
            }
        }

        /* Label Quick Access */
        .dev-tools-nav-label {
            color: #304766;
            font-size: 0.875rem;
            font-weight: 600;
            margin: 0 4px;
            white-space: nowrap;
        }

        /* Thẻ Select / Combo Box */
        .dev-tools-nav-combo-box {
            min-height: 32px;
            padding: 0 0.6rem;
            font-size: 0.875rem;
            color: #17345f;
            background: #ffffff;
            border: 1px solid #b9c9e2;
            border-radius: 6px;
            cursor: pointer;
            outline: none;

            &:focus {
                border-color: #2563eb;
                outline: 2px solid rgba(37, 99, 235, 0.18);
            }
        }

        /* Khối bên phải chứa ô Log và nhóm nút thao tác */
        .dev-tools-log-container {
            display: flex;
            align-items: center;
            gap: 6px;
            flex: 1;
            max-width: 55%;
            justify-content: flex-end;
        }

        /* Ô hiển thị thông báo Log */
        .small-log {
            margin: 0;
            padding: 4px 10px;
            font-size: 0.8rem;
            font-family: monospace;
            color: #526581;
            background: #f8fbff;
            border: 1px solid #dbe5f5;
            border-radius: 6px;
            width: 100%;
            max-height: 34px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            transition: max-height 0.25s ease;
        }

        /* Style ô log khi dev-tools được mở rộng */
        &.expanded .small-log {
            max-height: 125px;
            white-space: pre-wrap;
            overflow-y: auto;
            text-align: left;
        }

        /* Style cho các nút phụ bên phải ô log (Clear, Expand) */
        .dev-tools-action-btn {
            min-height: 32px;
            padding: 0 8px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.75rem;
            color: #304766;
            background: #f8fbff;
            border: 1px solid #b9c9e2;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            white-space: nowrap;

            &:hover {
                background: #eef4ff;
                border-color: #2563eb;
                color: #2563eb;
            }
        }

        /* Riêng nút Clear có tông màu cảnh báo nhạt */
        .dev-tools-clear-btn:hover {
            border-color: #f04438;
            color: #f04438;
            background: #fef3f2;
        }

        /* Style phân màu mã HTTP Status trong log */
        .log-status-2xx { color: #12b76a; font-weight: bold; } /* HTTP 200/201 Success */
        .log-status-4xx { color: #f04438; font-weight: bold; } /* HTTP 400/404 Error */
        .log-status-5xx { color: #d92d20; font-weight: bold; } /* HTTP 500 Server Error */
        .log-action     { color: #2563eb; }
    }
</style>

<div class="dev-tools">
    <div class="dev-tools-header">
        <div class="dev-tools-nav">
            <button class="dev-tools-nav-button" data-action="toggle-dev-tools">Previous</button>
            <label for="dev-tools-nav-combo-box" class="dev-tools-nav-label">Quick Access</label>
            
            <select class="dev-tools-nav-combo-box" id="dev-tools-nav-combo-box" data-action="select-dev-tool">
                <option value="" disabled selected>-- Chọn trang --</option>
                <option value="/Account/Login">Login</option>
                <option value="/Account/Signup">Signup</option>
                <option value="/Account/ForgetPassword">Forget Password</option>
                <option value="/Account/Profile">Profile</option>
                <option value="/Account/Authentication">Authentication</option>
            </select>
            
            <button class="dev-tools-nav-button" data-action="toggle-dev-tools">Next</button>
        </div>

        <div class="dev-tools-log-container">
            <div class="small-log">Ready.</div>
            <button class="dev-tools-action-btn dev-tools-clear-btn" title="Clear Logs & Storage">Clear</button>
            <button class="dev-tools-action-btn dev-tools-expand-btn" title="Expand/Collapse Log">▲</button>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const STORAGE_KEY = 'dev_tools_logs_history';
        const MAX_LOGS = 50; // Giới hạn lưu tối đa 50 log gần nhất để tránh phình dung lượng localStorage

        const devTools = document.querySelector('.dev-tools');
        const devToolsNavButtons = document.querySelectorAll('.dev-tools-nav-button');
        const devToolsNavComboBox = document.querySelector('.dev-tools-nav-combo-box');
        const smallLog = document.querySelector('.small-log');
        const expandBtn = document.querySelector('.dev-tools-expand-btn');
        const clearBtn = document.querySelector('.dev-tools-clear-btn');

        // 1. Tải danh sách log từ localStorage khi trang được tải lại/chuyển trang
        function loadSavedLogs() {
            const savedLogs = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
            if (savedLogs.length > 0) {
                renderLogs(savedLogs);
            } else {
                smallLog.innerHTML = 'Ready.';
            }
        }

        // Render toàn bộ danh sách log ra HTML
        function renderLogs(logs) {
            if (!devTools.classList.contains('expanded')) {
                // Nếu đang thu gọn: Chỉ hiển thị log mới nhất
                const lastLog = logs[logs.length - 1];
                smallLog.innerHTML = `[${lastLog.time}] <span class="${lastLog.typeClass}">${lastLog.message}</span>`;
            } else {
                // Nếu đang mở rộng: Hiển thị đầy đủ danh sách
                smallLog.innerHTML = logs.map(item => 
                    `<div>[${item.time}] <span class="${item.typeClass}">${item.message}</span></div>`
                ).join('');
                smallLog.scrollTop = smallLog.scrollHeight; // Tự cuộn xuống dưới cùng
            }
        }

        // 2. Hàm ghi log mới và lưu đồng thời vào localStorage
        function appendLog(message, typeClass = '') {
            const now = new Date().toLocaleTimeString();
            const newLog = { time: now, message: message, typeClass: typeClass };
            
            let logs = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
            logs.push(newLog);

            // Tự động giới hạn số lượng log lưu giữ
            if (logs.length > MAX_LOGS) {
                logs = logs.slice(logs.length - MAX_LOGS);
            }

            localStorage.setItem(STORAGE_KEY, JSON.stringify(logs));
            renderLogs(logs);
        }

        // Khởi chạy tải log cũ ngay khi trang load xong
        loadSavedLogs();

        // 3. Nút Clear: Xóa toàn bộ dữ liệu log đã lưu trong localStorage & giải phóng DOM
        clearBtn.addEventListener('click', function(e) {
            e.stopPropagation(); // Tránh kích hoạt sự kiện khác
            localStorage.removeItem(STORAGE_KEY);
            smallLog.innerHTML = 'Logs cleared.';
        });

        // 4. Nút Expand/Collapse ô Log
        expandBtn.addEventListener('click', function() {
            devTools.classList.toggle('expanded');
            expandBtn.textContent = devTools.classList.contains('expanded') ? '▼' : '▲';
            
            // Re-render lại dạng xem log phù hợp với trạng thái mở rộng/thu gọn
            loadSavedLogs();
        });

        // 5. Nút Toggle Ẩn/Hiện thanh DevTools
        devToolsNavButtons.forEach(button => {
            button.addEventListener('click', function() {
                const action = this.getAttribute('data-action');
                if (action === 'toggle-dev-tools') {
                    devTools.classList.toggle('hidden');
                }
            });
        });

        // 6. Chuyển hướng trang khi chọn item trong Combo Box
        devToolsNavComboBox.addEventListener('change', function() {
            const selectedUrl = this.value;
            if (selectedUrl) {
                appendLog(`Navigating to: ${selectedUrl}`, 'log-action');
                window.location.href = selectedUrl;
            }
        });

        // 7. Interceptor: Theo dõi và ghi vết toàn bộ yêu cầu HTTP Fetch (HTTP 200, 4xx, 5xx)
        const originalFetch = window.fetch;
        window.fetch = async function(...args) {
            const url = typeof args[0] === 'string' ? args[0] : args[0].url;
            try {
                const response = await originalFetch.apply(this, args);
                const status = response.status;
                let statusClass = 'log-status-2xx';
                if (status >= 400 && status < 500) statusClass = 'log-status-4xx';
                if (status >= 500) statusClass = 'log-status-5xx';

                appendLog(`FETCH [${status}] ${url}`, statusClass);
                return response;
            } catch (err) {
                appendLog(`FETCH [FAILED] ${url}`, 'log-status-5xx');
                throw err;
            }
        };

        // 8. Theo dõi các thao tác click trên màn hình
        document.addEventListener('click', function(e) {
            const target = e.target.closest('button, a, input[type="submit"]');
            if (target && !devTools.contains(target)) {
                const identifier = target.id ? `#${target.id}` : (target.className ? `.${target.className.split(' ')[0]}` : target.tagName);
                appendLog(`CLICKED: ${identifier}`, 'log-action');
            }
        }, true);
    });
</script>