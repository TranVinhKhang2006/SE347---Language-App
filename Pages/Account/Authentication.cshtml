@page
<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title data-i18n="global.signup">Đăng ký</title>
        <!-- Apply LoginBranch.css before Authentication.css to ensure proper styling -->
        <link rel="stylesheet" href="~/css/LoginBranch.css"/>
        <link rel="stylesheet" href="~/css/Authentication.css"/>
        <script src="~/js/authentication.js" defer></script>
    </head>
    <body>
		<main class="account-page"><a class="account-brand" href="/Index">SE347 Language App</a><section class="account-card" aria-labelledby="authentication-title"><div class="account-card__heading"><p class="account-eyebrow">Bảo mật tài khoản</p><h1 id="authentication-title">Xác thực email</h1><p>Nhập mã 6 chữ số đã được gửi đến email của bạn.</p></div><form class="account-form" action="#" method="post"><label>Mã xác thực<input class="verification-code" type="text" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="000000" required></label><button type="submit">Xác nhận tài khoản</button></form><p class="account-switch">Chưa nhận được mã? <a href="#">Gửi lại mã</a></p></section></main>
    </body>
</html>