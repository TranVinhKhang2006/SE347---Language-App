# =====================================================================
# Biến môi trường cho SE347 (Supabase). File mẫu: CHỈ ghi tên biến.
#   - Local:  dùng `dotnet user-secrets` (xem supabase/README.md), không cần file .env
#   - Docker: copy thành .env rồi `docker run --env-file .env ...`
#   - Render: khai báo từng biến trong Dashboard -> Environment
# .env đã nằm trong .gitignore. TUYỆT ĐỐI không commit key thật.
#
# Tên biến dùng "__" để ASP.NET Core map thành section:
#   Supabase__Url  ->  builder.Configuration["Supabase:Url"]
# =====================================================================

# Project Settings -> Data API -> Project URL
Supabase__Url=https://<project-ref>.supabase.co

# Project Settings -> API Keys -> Publishable key (sb_publishable_...)
# (project cũ: "anon public"). Được phép gửi xuống trình duyệt.
Supabase__PublishableKey=

# Project Settings -> API Keys -> Secret key (sb_secret_...)
# (project cũ: "service_role"). CHỈ backend dùng, bỏ qua RLS. Không đưa vào wwwroot/JS.
Supabase__SecretKey=

# Connect -> Session pooler -> chọn ".NET". Thay [YOUR-PASSWORD] bằng Database password.
# Không dùng Direct connection (chỉ IPv6, Render không kết nối được).
ConnectionStrings__Supabase=Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=<db-password>;SSL Mode=Require;Trust Server Certificate=true
